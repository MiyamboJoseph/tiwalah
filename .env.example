# Copy these values into your terminal before starting the Phoenix server.
# Never commit an actual .env file or a Gmail App Password.
SMTP_RELAY=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
MAIL_FROM_EMAIL=your-gmail@gmail.com
MAIL_FROM_NAME=Tilawah Recitation Circle
UMMAH_API_KEY=your-ummahapi-key
