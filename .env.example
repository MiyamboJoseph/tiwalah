# Configure these in your hosting provider or local environment.
# Use an SMTP app password/API SMTP credential, not a personal mailbox password.
SMTP_RELAY=smtp.gmail.com
# Gmail: 465 uses implicit SSL. Other providers often use 587 with STARTTLS.
SMTP_PORT=465
SMTP_USERNAME=your-smtp-username@example.com
SMTP_PASSWORD=your-smtp-app-password
MAIL_FROM_EMAIL=no-reply@your-domain.example
MAIL_FROM_NAME=Tilawah Recitation Circle
