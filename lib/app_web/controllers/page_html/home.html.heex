<div class="min-h-screen bg-[#f8f6ee] text-emerald-950">
  <header class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-4 sm:px-6 sm:py-6">
    <a href="/" class="min-w-0 flex items-center gap-2 sm:gap-3">
      <span class="grid size-10 place-items-center rounded-xl bg-emerald-800 text-lg text-amber-200">
        ۞
      </span>
      <span>
        <span class="block font-serif text-xl font-bold">Tilawah</span>
        <span class="block text-[10px] font-bold uppercase tracking-[0.18em] text-amber-700">
          Recitation circle
        </span>
      </span>
    </a>
    <div class="flex shrink-0 items-center gap-2 sm:gap-4">
      <a href="/users/log-in" class="text-xs font-semibold text-emerald-800 sm:text-sm">
        Sign in
      </a>
      <a
        href="/users/register"
        class="rounded-lg bg-emerald-800 px-3 py-2 text-xs font-semibold text-white shadow-sm sm:px-4 sm:text-sm"
      >
        Join Tilawah
      </a>
    </div>
  </header>
  <main class="mx-auto grid max-w-7xl gap-8 px-4 pb-12 pt-8 sm:gap-12 sm:px-6 sm:pb-16 sm:pt-12 lg:grid-cols-[1.2fr_.8fr] lg:items-center lg:pt-24">
    <section>
      <p class="text-sm font-bold uppercase tracking-[0.22em] text-amber-700">
        For Qur’an teachers & serious students
      </p>
      <h1 class="mt-5 max-w-3xl font-serif text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
        Preserve correct recitation. Guide every student with care.
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-7 text-stone-700 sm:text-lg sm:leading-8">
        Tilawah gives imams, sheikhs, maulanas, madrasahs, and hifz circles a focused way to assign recitation, listen attentively, and give clear tajwīd and hifz guidance.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="/users/register?role=student"
          class="rounded-xl bg-emerald-800 px-5 py-3 font-semibold text-white shadow-sm transition hover:bg-emerald-900"
        >
          Join as student
        </a>
        <a
          href="/users/register?role=tutor"
          class="rounded-xl border border-emerald-800 px-5 py-3 font-semibold text-emerald-900"
        >
          Join as Qur’an teacher
        </a>
      </div>
      <p class="mt-6 text-sm text-stone-600">
        Built for focused Qur’an study, responsible teaching, and consistent revision.
      </p>
    </section>
    <aside class="relative rounded-[2rem] bg-emerald-950 p-7 text-amber-50 shadow-xl sm:p-10">
      <div class="absolute right-8 top-7 text-6xl text-amber-300/20">۞</div>
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-amber-300">
        A guided recitation circle
      </p>
      <ol class="mt-8 space-y-6">
        <li class="flex gap-4">
          <span class="grid size-8 shrink-0 place-items-center rounded-full bg-amber-300 font-bold text-emerald-950">
            1
          </span>
          <div>
            <h2 class="font-serif text-xl font-bold">Assign a focused portion</h2>
            <p class="mt-1 text-sm leading-6 text-emerald-100">
              A teacher sets a clear Juz, surah, ayah range, and practice expectation.
            </p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="grid size-8 shrink-0 place-items-center rounded-full bg-amber-300 font-bold text-emerald-950">
            2
          </span>
          <div>
            <h2 class="font-serif text-xl font-bold">Recite with attention</h2>
            <p class="mt-1 text-sm leading-6 text-emerald-100">
              Students submit a careful recording from their own quiet place of study.
            </p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="grid size-8 shrink-0 place-items-center rounded-full bg-amber-300 font-bold text-emerald-950">
            3
          </span>
          <div>
            <h2 class="font-serif text-xl font-bold">Give precise guidance</h2>
            <p class="mt-1 text-sm leading-6 text-emerald-100">
              Teachers approve, request revision, and leave gentle, actionable correction.
            </p>
          </div>
        </li>
      </ol>
    </aside>
  </main>
</div>
